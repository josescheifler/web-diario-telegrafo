generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id              String   @id @default(cuid())
  title           String
  header          String
  content         String   @db.Text
  featuredImage   String
  section         Section
  authorId        String
  author          Author   @relation(fields: [authorId], references: [id])
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Author {
  id          String    @id @default(cuid())
  name        String
  profilePic  String?
  bio         String?
  isFeatured  Boolean   @default(false)
  articles    Article[]
}

model Advertisement {
  id          String   @id @default(cuid())
  name        String
  adCode      String   @db.Text
  location    String
  isActive    Boolean  @default(true)
}

enum Section {
  ECONOMIA
  LOCAL
  REGIONAL
  MUNDO
  PAIS
  POLITICA
  SOCIEDAD
}

// Mensajes que los lectores envían desde "Escribir a la redacción" y "Cartas de lectores".
// Se leen en el panel → Mensajes. La tabla se crea sola la primera vez (ver lib/mensajes.ts).
model Message {
  id        String   @id @default(cuid())
  kind      String   // CONTACTO o CARTA
  name      String
  email     String?
  locality  String?
  subject   String?
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
